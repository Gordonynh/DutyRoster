<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:shared="using:ClassIsland.PluginShared"
                     xmlns:views="clr-namespace:ClassIsland.DutyRoster.Views"
                     x:Class="ClassIsland.DutyRoster.Views.DutySettingsPage">

    <!--
        两个 Tab，各自带一个 ScrollViewer：共用一个滚动条的话，切 Tab 时滚动位置会串。
        Classes 里的 settings-container / animated-intro 是宿主设置页的惯例类，
        必须挂在每个 Tab 的 StackPanel 上，光挂外层的话 Tab 切换就没有入场动画。
    -->
    <TabControl x:Name="RootTabs" Classes="compact" Padding="0">

        <!-- ===== 常规设置 ===== -->
        <TabItem Header="常规设置">
            <ScrollViewer>
                <StackPanel Classes="settings-container animated-intro">

                    <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                               Text="到点自动弹出值日安排。提醒形式、位置、关闭方式都在这一页调；值日表本身的内容在旁边的「值日表设置」里看和改。"/>

                    <Separator Margin="0 12 0 4"/>
                    <ci:IconText Glyph="&#xEA8F;" Text="提醒" Margin="0 0 0 4"/>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xEA8F;}"
                                               Header="启用值日提醒">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}"/>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE823;}"
                                               Header="提前提醒"
                                               Description="提前几分钟提醒。0 为准点。">
                        <controls:SettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Slider Width="170" Minimum="0" Maximum="15" TickFrequency="1"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        Value="{Binding Settings.LeadMinutes, Mode=TwoWay}"/>
                                <TextBlock VerticalAlignment="Center" MinWidth="54"
                                           Text="{Binding Settings.LeadMinutes, StringFormat='{}{0} 分钟'}"/>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE916;}"
                                               Header="弹窗停留"
                                               Description="仅对没有结束时间的时刻生效。有结束时间的时间段会一直显示到结束。">
                        <controls:SettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Slider Width="170" Minimum="3" Maximum="600" TickFrequency="1"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        Value="{Binding Settings.HoldSeconds, Mode=TwoWay}"/>
                                <TextBlock VerticalAlignment="Center" MinWidth="54"
                                           Text="{Binding Settings.HoldSeconds, StringFormat='{}{0} 秒'}"/>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE823;}"
                                               Header="触发延迟"
                                               Description="到点后延迟几秒弹出，避开铃声。">
                        <controls:SettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Slider Width="170" Minimum="0" Maximum="60" TickFrequency="1"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        Value="{Binding Settings.FireDelaySeconds, Mode=TwoWay}"/>
                                <TextBlock VerticalAlignment="Center" MinWidth="54"
                                           Text="{Binding Settings.FireDelaySeconds, StringFormat='{}{0} 秒'}"/>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE767;}"
                                               Header="弹窗提示音">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding Settings.PlaySound, Mode=TwoWay}"/>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE711;}"
                                               Header="关闭方式"
                                               Description="决定弹窗出现后，除了自动消失，还能用什么办法手动关掉。">
                        <controls:SettingsExpander.Footer>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox Content="点击空白处或按任意键关闭"
                                              IsThreeState="False"
                                              IsChecked="{Binding Settings.CloseOnClickAnywhere, Mode=TwoWay}"/>
                                    <CheckBox Content="右上角按钮关闭"
                                              IsThreeState="False"
                                              IsChecked="{Binding Settings.CloseWithButton, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                                           Text="两个都不勾选时，弹窗不会响应点击和按键，但仍会按「弹窗停留」或时间段的结束时间自动消失。教室大屏往往没有键盘，建议至少保留一种手动关闭方式。"/>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <Separator Margin="0 12 0 4"/>
                    <ci:IconText Glyph="&#xE8A9;" Text="提醒形式" Margin="0 0 0 4"/>

                    <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                               Text="日常时间点与大扫除可分别设置提醒形式。含「扫地」「拖地」的时间点判定为大扫除。"/>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A9;}"
                                               Header="日常提醒形式"
                                               Description="擦黑板、倒垃圾等常规安排。">
                        <controls:SettingsExpander.Footer>
                            <ComboBox MinWidth="170" SelectedIndex="{Binding FrequentStyleIndex, Mode=TwoWay}">
                                <ComboBoxItem>卡片浮窗</ComboBoxItem>
                                <ComboBoxItem>整屏 UltraCode</ComboBoxItem>
                                <ComboBoxItem>只发 ClassIsland 提醒</ComboBoxItem>
                                <ComboBoxItem>不提醒</ComboBoxItem>
                            </ComboBox>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE74D;}"
                                               Header="大扫除提醒形式"
                                               Description="全班扫除。默认整屏提醒。">
                        <controls:SettingsExpander.Footer>
                            <ComboBox MinWidth="170" SelectedIndex="{Binding SweepStyleIndex, Mode=TwoWay}">
                                <ComboBoxItem>卡片浮窗</ComboBoxItem>
                                <ComboBoxItem>整屏 UltraCode</ComboBoxItem>
                                <ComboBoxItem>只发 ClassIsland 提醒</ComboBoxItem>
                                <ComboBoxItem>不提醒</ComboBoxItem>
                            </ComboBox>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE71C;}"
                                               Header="哪些项目算大扫除"
                                               Description="{Binding SweepSummary}">
                        <shared:TokenListEditor x:Name="SweepProjectsEditor"/>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE80A;}"
                                               Header="整屏动画颗粒"
                                               Description="仅影响整屏提醒。调大可降低性能占用，颗粒更粗。">
                        <controls:SettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Slider Width="170" Minimum="3" Maximum="40" TickFrequency="1"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        Value="{Binding Settings.SweepCellSize, Mode=TwoWay}"/>
                                <TextBlock VerticalAlignment="Center" MinWidth="54"
                                           Text="{Binding SweepCellText}"/>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8D2;}"
                                               Header="整屏提醒的大标题">
                        <controls:SettingsExpander.Footer>
                            <TextBox MinWidth="220" Text="{Binding Settings.SweepTitle, Mode=TwoWay}"/>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <Separator Margin="0 12 0 4"/>
                    <ci:IconText Glyph="&#xE7F4;" Text="外观" Margin="0 0 0 4"/>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE7F4;}"
                                               Header="弹窗位置">
                        <controls:SettingsExpander.Footer>
                            <ComboBox MinWidth="150" SelectedIndex="{Binding PlacementIndex, Mode=TwoWay}">
                                <ComboBoxItem>屏幕正中</ComboBoxItem>
                                <ComboBoxItem>顶部居中</ComboBoxItem>
                                <ComboBoxItem>右下角</ComboBoxItem>
                            </ComboBox>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A9;}"
                                               Header="弹窗大小">
                        <controls:SettingsExpander.Footer>
                            <ComboBox MinWidth="150" SelectedIndex="{Binding ScaleIndex, Mode=TwoWay}">
                                <ComboBoxItem>紧凑</ComboBoxItem>
                                <ComboBoxItem>标准</ComboBoxItem>
                                <ComboBoxItem>大</ComboBoxItem>
                            </ComboBox>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <Separator Margin="0 12 0 4"/>
                    <ci:IconText Glyph="&#xE91C;" Text="其他通道" Margin="0 0 0 4"/>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE91C;}"
                                               Header="同时发送 ClassIsland 提醒"
                                               Description="主界面提醒空间有限，仅作补充。">
                        <controls:SettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding Settings.AlsoSendClassIslandNotification, Mode=TwoWay}"/>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===== 值日表设置 ===== -->
        <TabItem Header="值日表设置">
            <ScrollViewer>
                <StackPanel Classes="settings-container animated-intro">

                    <!-- ===== 显示（只读） ===== -->
                    <ci:IconText Glyph="&#xE8A5;" Text="查看今天" Margin="0 0 0 4"/>

                    <controls:InfoBar Severity="Warning"
                                      Title="值日表存在错误"
                                      Message="{Binding WarningText}"
                                      IsOpen="{Binding HasWarnings}"
                                      IsClosable="False"
                                      Margin="0 0 0 8"/>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A5;}"
                                               IsExpanded="True"
                                               Header="今天谁值日"
                                               Description="{Binding TodaySummary}">
                        <controls:SettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnPreviewCard">
                                    <ci:IconText Glyph="&#xE7B3;" Text="试弹卡片"/>
                                </Button>
                                <Button Click="OnPreviewSweep">
                                    <ci:IconText Glyph="&#xE7B3;" Text="试弹整屏"/>
                                </Button>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE787;}"
                                               Header="今天的安排"
                                               Description="{Binding TodaySlotsSummary}">
                        <!--
                            内容放 Footer 而不是写成 Expander 的直接子元素：
                            SettingsExpander 是 HeaderedItemsControl，直接子元素会进 Items，
                            那是留给 SettingsExpanderItem 的位置；装一段自由布局进去语义不对。
                            Footer 是普通的内容槽，宿主 WeatherSettingsPage 也是这么往里面放列表的。
                        -->
                        <controls:SettingsExpander.Footer>
                            <StackPanel Spacing="6" MinWidth="560">

                                <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                                           Text="带结束时间的是时段，只有开始时间的是单时刻。"/>

                                <Grid ColumnDefinitions="108,*,*,64" ColumnSpacing="10" Margin="8 0">
                                    <TextBlock Grid.Column="0" Classes="l-instructive" Text="时间"/>
                                    <TextBlock Grid.Column="1" Classes="l-instructive" Text="项目"/>
                                    <TextBlock Grid.Column="2" Classes="l-instructive" Text="负责人"/>
                                    <TextBlock Grid.Column="3" Classes="l-instructive" Text="大扫除"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding TodaySlots}"
                                         MaxHeight="320"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="108,*,*,64" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                           FontFamily="Consolas, monospace"
                                                           Text="{Binding TimeText}"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Text="{Binding ProjectText}"/>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Text="{Binding PeopleText}"/>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                           Text="{Binding SweepText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                                           IsVisible="{Binding TodayHasNoSlots}"
                                           Text="今天没有安排，或者值日表还没配置。"/>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8E5;}"
                                               Header="值日表文件"
                                               Description="{Binding RosterSummary}">
                        <controls:SettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnOpenRoster">
                                    <ci:IconText Glyph="&#xE8E5;" Text="打开"/>
                                </Button>
                                <Button Click="OnReload">
                                    <ci:IconText Glyph="&#xE117;" Text="重新载入"/>
                                </Button>
                            </StackPanel>
                        </controls:SettingsExpander.Footer>
                    </controls:SettingsExpander>

                    <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                               Text="值日表是纯文本，用记事本也能改，保存后自动生效。写 08:40-08:50 会从开始显示到结束；只写 08:40 会按「弹窗停留」秒数消失。"/>

                    <Separator Margin="0 16 0 8"/>

                    <!-- ===== 配置（可视化编辑） ===== -->
                    <ci:IconText Glyph="&#xE70F;" Text="编辑值日表" Margin="0 0 0 4"/>

                    <views:DutyScheduleEditor x:Name="ScheduleEditor"/>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</ci:SettingsPageBase>
